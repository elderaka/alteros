      "nodes": [
        {
          "id": "compliment_002_01",
          "speaker": "alterra",
          "text": "ふふ。褒めれば何でも通ると思ってない？",
          "displayText": "Hehe. You do not think compliments make everything pass, do you?",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "compliment_002_02",
          "presentation": {
            "expression": "teasing",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "compliment_002_02",
          "speaker": "alterra",
          "text": "通らないよ。……ちょっとだけ嬉しいけど。",
          "displayText": "It does not. ...Though I am a little happy.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
