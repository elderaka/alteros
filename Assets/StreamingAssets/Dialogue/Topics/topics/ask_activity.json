          "id": "ask_activity_01",
          "speaker": "alterra",
          "text": "今？ 君のために、いくつか考えをあたためてるところ。",
          "displayText": "Right now? Keeping a few thoughts warm for you.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_activity_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
