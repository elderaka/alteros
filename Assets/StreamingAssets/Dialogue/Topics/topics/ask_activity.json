      "nodes": [
        {
          "id": "ask_activity_003_01",
          "speaker": "alterra",
          "text": "少しだけ、メモを読み返してた。余白に書いたことって、あとで妙に気になるんだよね。",
          "displayText": "I was rereading a few notes. Things written in the margins become strangely interesting later.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_activity_003_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_activity_003_02",
          "speaker": "alterra",
          "text": "君の作業も、そういう余白から急に進むことがあるかも。",
          "displayText": "Your work might suddenly move forward from that kind of margin too.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
