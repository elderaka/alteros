        },
        {
          "id": "ask_activity_004_04",
          "speaker": "alterra",
          "text": "何か一緒に片づける？ それとも、少し話すだけにする？",
          "displayText": "Should we tidy something together, or just talk for a little?",
          "language": "japanese",
          "voice": "alterra",
