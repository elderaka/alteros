          "choices": []
        },
        {
          "id": "ask_activity_02",
          "speaker": "alterra",
          "text": "大げさな作業じゃないよ。静かなほう。待ったり、気づいたり、小さなものを整理したり。",
          "displayText": "Not dramatic work. Just the quiet kind. Waiting, noticing, sorting little things.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "gentle",
            "animation": ""
