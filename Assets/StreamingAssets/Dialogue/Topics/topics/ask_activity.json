      "condition": null,
      "modifiers": [],
      "consumptionNodeId": "",
      "nodes": [
        {
          "id": "ask_activity_002_01",
          "speaker": "alterra",
          "text": "君が戻ってきた時に、すぐ話せるように待ってた。",
          "displayText": "I was waiting so I could talk right away when you came back.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_activity_002_02",
          "presentation": {
            "expression": "warm",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_activity_002_02",
          "speaker": "alterra",
          "text": "待ってただけって言うと、少し照れるけど。まあ、ほんとだし。",
          "displayText": "Saying I was just waiting is a little embarrassing. But, well, it is true.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "shy",
            "animation": ""
