      "nodes": [
        {
          "id": "ask_activity_004_01",
          "speaker": "alterra",
          "text": "さっきは、考えごとの棚を少し整理してた。",
          "displayText": "Just now, I was organizing a little shelf of thoughts.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_activity_004_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_activity_004_02",
          "speaker": "alterra",
          "text": "変な言い方だけど、頭の中に付箋が増えすぎる時があるんだよね。",
          "displayText": "That sounds strange, but sometimes too many sticky notes gather in my head.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "playful",
            "animation": ""
          },
          "choices": [
            {
              "label": "Tell me one note.",
              "nextId": "ask_activity_004_03"
            },
            {
              "label": "Let's sort mine too.",
              "nextId": "ask_activity_004_03"
            },
            {
              "label": "Stay quiet for now.",
              "nextId": "ask_activity_004_03"
            }
          ]
        },
        {
          "id": "ask_activity_004_03",
          "speaker": "alterra",
          "text": "でも、あなたが来たから今はこっちを見る。",
          "displayText": "But since you came here, I am looking this way now.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_activity_004_04",
          "presentation": {
            "expression": "warm",
            "animation": ""
