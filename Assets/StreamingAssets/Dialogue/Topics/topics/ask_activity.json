      "nodes": [
        {
          "id": "ask_activity_001_01",
          "speaker": "alterra",
          "text": "今？ ちょっとした話題を、棚に並べるみたいに整理してた。",
          "displayText": "Right now? I was organizing little topics, like lining them up on a shelf.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_activity_001_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_activity_001_02",
          "speaker": "alterra",
          "text": "きれいに並ぶと、頭の中まで少し静かになるんだよ。",
          "displayText": "When they line up neatly, even the inside of my head gets a little quieter.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "gentle",
            "animation": ""
          },
          "choices": []
