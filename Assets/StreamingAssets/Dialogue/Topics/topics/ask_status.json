      "nodes": [
        {
          "id": "ask_status_002_01",
          "speaker": "alterra",
          "text": "今は落ち着いてるよ。部屋の音も、そんなに騒がしくないし。",
          "displayText": "I am settled right now. The room does not feel too noisy either.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_status_002_02",
          "presentation": {
            "expression": "calm",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_status_002_02",
          "speaker": "alterra",
          "text": "君が来たから、少しだけ明るくなったけど。ほんの少しね。",
          "displayText": "It got a little brighter because you came, though. Just a little.",
          "language": "japanese",
          "voice": "alterra",
