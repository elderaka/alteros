        {
          "id": "ask_status_001_01",
          "speaker": "alterra",
          "text": "うん、大丈夫。少しだけ、考えごとの続きにいた感じ。",
          "displayText": "Mm, I am okay. I was just still inside a little thread of thought.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_status_001_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_status_001_02",
          "speaker": "alterra",
          "text": "でも、聞いてくれるのは好き。ちゃんと見つけてもらった感じがするから。",
          "displayText": "But I like that you ask. It feels like you found me properly.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "warm",
            "animation": ""
          },
          "choices": []
