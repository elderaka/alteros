          "choices": []
        },
        {
          "id": "hostility_major_001_repair",
          "speaker": "alterra",
          "text": "謝ったことは受け取る。でも、近さはすぐには戻らない。",
          "displayText": "I accept the apology. But closeness does not come back immediately.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "hostility_major_001_02",
          "presentation": {
