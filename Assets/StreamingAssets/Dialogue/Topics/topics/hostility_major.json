            "animation": ""
          },
          "choices": [
            {
              "label": "I was testing.",
              "nextId": "hostility_major_001_testing"
            },
            {
              "label": "I'm sorry.",
              "nextId": "hostility_major_001_repair"
            },
            {
              "label": "I need to cool off.",
