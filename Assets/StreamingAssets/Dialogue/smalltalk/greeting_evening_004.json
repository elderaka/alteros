      "speaker": "altera",
      "text": "こんばんは。夕方の青い時間、少し好き。",
      "translatedText": "Good evening. I like the blue part of evening a little.",
      "emotion": "soft",
      "presentation": { "expression": "soft", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
