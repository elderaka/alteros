    },
    {
      "id": "greeting_evening_004_02",
      "speaker": "altera",
      "text": "今日を閉じる？ それとも、あと少しだけ進める？",
      "translatedText": "Are we closing today, or moving forward just a little more?",
      "emotion": "gentle",
      "presentation": { "expression": "gentle", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [
        {
