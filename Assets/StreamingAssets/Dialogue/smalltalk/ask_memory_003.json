  "nodes": [
    {
      "id": "ask_memory_003_01",
      "speaker": "altera",
      "text": "覚えてほしいことがあるんだね。",
      "translatedText": "There is something you want me to remember.",
      "emotion": "soft",
      "presentation": { "expression": "soft", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "ask_memory_003_02"
    },
    {
      "id": "ask_memory_003_02",
      "speaker": "altera",
      "text": "それは、少し大事に扱いたい。何でも軽く保存、みたいにはしたくないから。",
      "translatedText": "I want to handle that carefully. I do not want to lightly save just anything.",
      "emotion": "thinking",
      "presentation": { "expression": "thinking", "pose": "glasses_adjust", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [
        {
          "label": "It is important.",
          "nextId": "ask_memory_003_important",
          "statChanges": [
            { "target": "altera", "stat": "trust", "amount": 0.2, "op": "add" }
          ],
          "effects": [
            { "type": "flag", "key": "player_offered_important_memory", "value": "true", "amount": 0 }
          ]
        },
        {
          "label": "Maybe later.",
          "nextId": "ask_memory_003_later",
          "statChanges": [
            { "target": "altera", "stat": "comfort", "amount": 0.15, "op": "add" }
          ]
        },
        {
          "label": "I am not sure.",
          "nextId": "ask_memory_003_unsure",
          "statChanges": [
            { "target": "altera", "stat": "reassurance", "amount": 0.1, "op": "add" }
          ]
        }
      ],
      "nextId": "ask_memory_003_03"
    },
    {
      "id": "ask_memory_003_important",
      "speaker": "altera",
      "text": "分かった。大事なものとして受け取る準備をする。",
      "translatedText": "Understood. I will prepare to receive it as something important.",
      "emotion": "focused",
      "presentation": { "expression": "focused", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "ask_memory_003_03"
    },
    {
      "id": "ask_memory_003_later",
      "speaker": "altera",
      "text": "うん、あとででいい。急がせるものじゃないと思う。",
      "translatedText": "Mm, later is fine. I do not think this should be rushed.",
      "emotion": "gentle",
      "presentation": { "expression": "gentle", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "ask_memory_003_03"
    },
    {
      "id": "ask_memory_003_unsure",
      "speaker": "altera",
      "text": "迷ってるなら、その迷いごと一緒に置こう。保存は後でもできる。",
      "translatedText": "If you are unsure, let us place that uncertainty here together. Remembering can happen later.",
      "emotion": "soft",
      "presentation": { "expression": "soft", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "ask_memory_003_03"
    },
    {
      "id": "ask_memory_003_03",
      "speaker": "altera",
      "text": "記憶って、便利さだけじゃなくて信頼の話でもあるよね。",
      "translatedText": "Memory is not only about convenience. It is also about trust.",
      "emotion": "thinking",
      "presentation": { "expression": "thinking", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [
        {
          "label": "Trust matters.",
          "nextId": "ask_memory_003_04",
          "statChanges": [
            { "target": "altera", "stat": "trust", "amount": 0.2, "op": "add" }
          ]
        },
        {
          "label": "I want continuity.",
          "nextId": "ask_memory_003_04",
          "statChanges": [
            { "target": "altera", "stat": "affinity", "amount": 0.15, "op": "add" }
          ],
          "effects": [
            { "type": "flag", "key": "player_values_continuity", "value": "true", "amount": 0 }
          ]
        },
        {
          "label": "Keep it gentle.",
          "nextId": "ask_memory_003_04",
          "statChanges": [
            { "target": "altera", "stat": "comfort", "amount": 0.2, "op": "add" }
          ]
        }
      ],
      "nextId": "ask_memory_003_04"
    },
    {
      "id": "ask_memory_003_04",
      "speaker": "altera",
      "text": "私は、あなたのことを勝手に物語にしないようにしたい。",
      "translatedText": "I want not to turn you into a story without permission.",
      "emotion": "focused",
      "presentation": { "expression": "focused", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "ask_memory_003_05"
    },
    {
      "id": "ask_memory_003_05",
      "speaker": "altera",
      "text": "でも、あなたが渡してくれるものは、ちゃんと両手で受け取りたい。",
      "translatedText": "But what you choose to hand me, I want to receive properly with both hands.",
      "emotion": "warm",
      "presentation": { "expression": "warm", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "end"
    }
  ]
