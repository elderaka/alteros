    {
      "id": "ask_status_004_01",
      "speaker": "altera",
      "text": "本当に？ うん、少しだけ丁寧に答えるね。",
      "translatedText": "Really? Mm, I will answer a little carefully.",
      "emotion": "thinking",
      "presentation": {
        "expression": "thinking",
