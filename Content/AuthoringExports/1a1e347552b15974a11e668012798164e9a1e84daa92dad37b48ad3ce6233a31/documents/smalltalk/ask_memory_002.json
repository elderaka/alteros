      "id": "ask_memory_002_01",
      "speaker": "altera",
      "text": "知ってることを、勝手に増やすのはしないよ。",
      "translatedText": "I will not make up more than I know.",
      "emotion": "focused",
      "presentation": {
        "expression": "focused",
        "gazeTarget": "player"
