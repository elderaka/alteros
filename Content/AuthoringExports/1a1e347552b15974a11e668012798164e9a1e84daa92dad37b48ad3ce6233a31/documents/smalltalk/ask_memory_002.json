    },
    {
      "id": "ask_memory_002_02",
      "speaker": "altera",
      "text": "でも、あなたが何を大事にしてるかは、少しずつ見ていたい。",
      "translatedText": "But I do want to gradually notice what matters to you.",
      "emotion": "soft",
      "presentation": {
        "expression": "soft",
