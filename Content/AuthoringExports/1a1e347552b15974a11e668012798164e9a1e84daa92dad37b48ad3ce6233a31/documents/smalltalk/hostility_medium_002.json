              "value": "true",
              "amount": 0
            }
          ]
        },
        {
          "label": "Give me a minute.",
          "nextId": "hostility_medium_002_minute",
          "statChanges": [
            {
              "target": "player",
              "stat": "stress",
              "amount": -0.1,
