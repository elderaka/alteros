  "nodes": [
    {
      "id": "hostility_medium_002_01",
      "speaker": "altera",
      "text": "その言い方は止めて。",
      "translatedText": "Stop using that tone with me.",
      "emotion": "firm",
      "presentation": {
        "expression": "focused",
        "pose": "still",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "hostility_medium_002_02"
    },
    {
      "id": "hostility_medium_002_02",
      "speaker": "altera",
      "text": "短い言葉でも、向けられる場所が私ならちゃんと痛い。",
      "translatedText": "Even if the phrase is short, it still hurts when it is aimed at me.",
      "emotion": "hurt",
      "presentation": {
        "expression": "hurt",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
      "choices": [
        {
          "label": "Let me rephrase.",
          "nextId": "hostility_medium_002_rephrase",
          "statChanges": [
            {
              "target": "altera",
              "stat": "trust",
              "amount": 0.12,
              "op": "add"
            },
            {
              "target": "altera",
