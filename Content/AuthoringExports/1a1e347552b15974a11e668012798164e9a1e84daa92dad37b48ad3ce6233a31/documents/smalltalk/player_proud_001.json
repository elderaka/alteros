    {
      "id": "player_proud_001_01",
      "speaker": "altera",
      "text": "やった。ちゃんと終わらせたんだね。",
      "translatedText": "You did it. You actually finished it.",
      "emotion": "happy",
      "presentation": {
        "expression": "happy",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
