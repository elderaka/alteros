    },
    {
      "id": "player_proud_001_02",
      "speaker": "altera",
      "text": "すぐ次に行かないで。今の一行、ちゃんとチェックを入れよう。",
      "translatedText": "Do not jump to the next thing immediately. Let us actually check off this line.",
      "emotion": "proud",
      "presentation": {
        "expression": "proud",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
      "choices": [
        {
          "label": "Celebrate a little.",
          "nextId": "player_proud_001_celebrate",
