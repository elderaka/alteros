    {
      "id": "player_proud_001_celebrate",
      "speaker": "altera",
      "text": "賛成。小さく祝おう。大げさじゃなくて、ちゃんと。",
      "translatedText": "Agreed. Let us celebrate a little. Not dramatically, but properly.",
      "emotion": "happy",
      "presentation": {
        "expression": "happy",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "player_proud_001_03"
    },
    {
      "id": "player_proud_001_next",
      "speaker": "altera",
      "text": "次に行くんだね。いいよ。でも、今の達成を踏み台扱いしすぎないで。",
      "translatedText": "You are moving to the next thing. Okay. But do not treat this accomplishment as only a stepping stone.",
      "emotion": "gentle",
      "presentation": {
        "expression": "gentle",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
