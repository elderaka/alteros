    },
    {
      "id": "procrastination_short_002_02",
      "speaker": "altera",
      "text": "もう半分は、逃げ道をふさぐことじゃなくて、入口をかわいくすること。",
      "translatedText": "The other half is not blocking the escape route. It is making the entrance less awful.",
      "emotion": "playful",
      "presentation": {
        "expression": "playful",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
