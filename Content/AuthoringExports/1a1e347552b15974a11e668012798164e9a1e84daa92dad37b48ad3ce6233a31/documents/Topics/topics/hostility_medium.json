          "choices": []
        },
        {
          "id": "hostility_medium_001_02",
          "speaker": "alterra",
          "text": "怒りがあるなら、怒りとして言って。私を雑に殴る形にはしないで。",
          "displayText": "If there is anger, name it as anger. Do not shape it like hitting me carelessly.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "hostility_medium_001_03",
          "presentation": {
            "expression": "focused",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "hostility_medium_001_03",
          "speaker": "alterra",
          "text": "言い直してくれるなら、ここから聞き直す。",
          "displayText": "If you rephrase it, I will listen again from here.",
