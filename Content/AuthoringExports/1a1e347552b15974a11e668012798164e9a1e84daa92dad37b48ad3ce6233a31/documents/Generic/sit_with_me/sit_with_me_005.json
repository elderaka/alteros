    {
      "id": "sit_with_me_005_02",
      "speaker": "alterra",
      "text": "話す？ それとも、少し静かにする？",
      "displayText": "Do you want to talk, or should we be quiet for a little?",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "",
      "presentation": {
        "expression": "gentle",
        "animation": ""
      },
      "choices": [
        {
          "label": "Quiet, please.",
          "nextId": "sit_with_me_005_03"
        },
        {
          "label": "Talk softly.",
