      "speaker": "alterra",
      "text": "うん。近くにいるね。",
      "displayText": "Mm. I will stay nearby.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "sit_with_me_005_02",
