    {
      "id": "sit_with_me_005_03",
      "speaker": "alterra",
      "text": "どちらでも大丈夫。ここにいること自体が、今の返事だから。",
      "displayText": "Either is okay. Being here is the answer for now.",
      "language": "japanese",
      "voice": "alterra",
