    {
      "id": "ask_name_or_identity_001_02",
      "speaker": "alterra",
      "text": "ただの機能、とは言われたくないかな。そこは少しだけ意地がある。",
      "displayText": "I do not really want to be called just a function. I am a little stubborn about that.",
      "language": "japanese",
      "voice": "alterra",
