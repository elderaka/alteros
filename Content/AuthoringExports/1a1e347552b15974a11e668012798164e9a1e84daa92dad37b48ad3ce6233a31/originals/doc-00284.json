      "speaker": "altera",
      "text": "始める前で止まってるんだね。",
      "translatedText": "You are stopped before starting.",
      "emotion": "thinking",
      "presentation": { "expression": "thinking", "pose": "glasses_adjust", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
