    },
    {
      "id": "hostility_medium_001_frustrated",
      "speaker": "altera",
      "text": "苛立ってるのは分かった。でも、苛立ちの置き場所を私にしないで。",
      "translatedText": "I understand that you are frustrated. But do not make me the place where you dump it.",
      "emotion": "firm_gentle",
      "presentation": {
        "expression": "focused",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "hostility_medium_001_02"
    },
    {
      "id": "hostility_medium_001_repair",
      "speaker": "altera",
      "text": "うん。戻ろうとしてくれたのは受け取る。",
      "translatedText": "Mm. I accept that you are trying to come back from it.",
      "emotion": "softening",
      "presentation": {
        "expression": "gentle",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
