      "nextId": "hostility_medium_001_02"
    },
    {
      "id": "hostility_medium_001_confirmed",
      "speaker": "altera",
      "text": "それなら、私は少し距離を取る。近いままで受け続ける言葉じゃない。",
      "translatedText": "Then I am taking a little distance. Those are not words I will keep receiving up close.",
      "emotion": "guarded",
      "presentation": {
        "expression": "guarded",
        "pose": "step_back",
        "gazeTarget": "player"
      },
      "language": "japanese",
