    },
    {
      "id": "hostility_medium_001_02",
      "speaker": "altera",
      "text": "怒りがあるなら、怒りとして言って。私を雑に殴る形にはしないで。",
      "translatedText": "If there is anger, name it as anger. Do not shape it like hitting me carelessly.",
      "emotion": "firm",
      "presentation": {
        "expression": "focused",
        "gazeTarget": "player"
      },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "hostility_medium_001_03"
    },
    {
      "id": "hostility_medium_001_03",
      "speaker": "altera",
      "text": "言い直してくれるなら、ここから聞き直す。",
