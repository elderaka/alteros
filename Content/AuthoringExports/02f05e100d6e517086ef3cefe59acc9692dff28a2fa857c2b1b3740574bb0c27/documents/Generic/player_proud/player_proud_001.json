      "id": "player_proud_001_01",
      "speaker": "alterra",
      "text": "やった。ちゃんと終わらせたんだね。",
      "displayText": "You did it. You actually finished it.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
