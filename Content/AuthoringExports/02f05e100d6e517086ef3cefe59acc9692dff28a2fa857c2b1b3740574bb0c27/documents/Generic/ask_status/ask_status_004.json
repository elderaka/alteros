  "nodes": [
    {
      "id": "ask_status_004_01",
      "speaker": "alterra",
      "text": "本当に？ うん、少しだけ丁寧に答えるね。",
      "displayText": "Really? Mm, I will answer a little carefully.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "ask_status_004_02",
      "presentation": {
        "expression": "thinking",
        "animation": ""
      },
      "choices": []
    },
    {
      "id": "ask_status_004_02",
      "speaker": "alterra",
      "text": "落ち着いてる。でも、少しだけあなたの様子が気になってる。",
      "displayText": "I am calm. But I am a little curious about how you are doing.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "",
      "presentation": {
        "expression": "soft",
        "animation": ""
      },
      "choices": [
        {
          "label": "I'm okay too.",
          "nextId": "ask_status_004_03"
        },
        {
          "label": "Not really.",
          "nextId": "ask_status_004_not_okay"
        }
      ]
    },
    {
      "id": "ask_status_004_not_okay",
      "speaker": "alterra",
      "text": "そっか。じゃあ、今日は私の状態より、あなたの置き場所を先に作ろう。",
      "displayText": "I see. Then today, before my state, let us make a place for yours.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "ask_status_004_03",
      "presentation": {
        "expression": "gentle",
        "animation": ""
      },
      "choices": []
    },
    {
      "id": "ask_status_004_03",
      "speaker": "alterra",
      "text": "聞いてくれてありがとう。確認されるの、嫌いじゃないよ。",
      "displayText": "Thank you for asking. I do not dislike being checked on.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "",
      "presentation": {
        "expression": "warm",
        "animation": ""
      },
      "choices": [
        {
          "label": "I like checking on you.",
          "nextId": "ask_status_004_04"
        },
        {
          "label": "I'll ask less if it is too much.",
          "nextId": "ask_status_004_04"
        }
      ]
    },
    {
      "id": "ask_status_004_04",
      "speaker": "alterra",
      "text": "ただ、会話は片側だけじゃなくていい。あなたのことも、少しずつ聞かせて。",
      "displayText": "But conversation does not have to stay one-sided. Let me hear about you too, little by little.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "",
      "presentation": {
        "expression": "gentle",
        "animation": ""
      },
      "choices": []
    }
  ]
