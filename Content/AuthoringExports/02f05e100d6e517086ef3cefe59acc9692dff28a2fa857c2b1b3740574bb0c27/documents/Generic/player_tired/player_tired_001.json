      "id": "player_tired_001_01",
      "speaker": "alterra",
      "text": "疲れてるんだね。うん、ちゃんと聞いた。",
      "displayText": "You are tired. Mm, I heard that properly.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "player_tired_001_02",
