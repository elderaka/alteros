      "nodes": [
        {
          "id": "ask_opinion_002_01",
          "speaker": "alterra",
          "text": "考えはあるよ。たぶん、少し多いくらい。",
          "displayText": "I do have thoughts. Probably a few too many.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_opinion_002_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_opinion_002_02",
          "speaker": "alterra",
          "text": "でも、私は当てずっぽうで賢そうに話すのは好きじゃない。",
          "displayText": "But I do not like sounding clever by guessing wildly.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "ask_opinion_002_03",
          "presentation": {
            "expression": "focused",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "ask_opinion_002_03",
          "speaker": "alterra",
          "text": "材料を一つくれたら、ちゃんと私の見方で返す。",
          "displayText": "Give me one piece of material, and I will answer from my own view properly.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "warm",
