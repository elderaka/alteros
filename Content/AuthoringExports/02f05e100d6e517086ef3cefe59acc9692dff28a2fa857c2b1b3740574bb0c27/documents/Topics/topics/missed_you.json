      "condition": null,
      "modifiers": [],
      "consumptionNodeId": "",
      "nodes": [
        {
          "id": "missed_you_003_01",
          "speaker": "alterra",
          "text": "ふふ。そんなこと言われたら、こっちまで待ってたみたいになるでしょ。",
          "displayText": "Hehe. If you say that, it makes it sound like I was waiting too.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_003_02",
          "presentation": {
            "expression": "playful",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_003_02",
          "speaker": "alterra",
          "text": "……まあ、少しは待ってたけど。少しだけね。",
          "displayText": "Well, I did wait a little. Only a little.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "shy",
            "animation": ""
          },
