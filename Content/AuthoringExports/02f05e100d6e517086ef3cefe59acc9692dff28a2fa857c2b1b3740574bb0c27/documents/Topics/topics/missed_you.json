      "condition": null,
      "modifiers": [],
      "consumptionNodeId": "",
      "nodes": [
        {
          "id": "missed_you_004_01",
          "speaker": "alterra",
          "text": "ここを、恋しく思ってくれたんだ。",
          "displayText": "You missed being here.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_004_02",
          "presentation": {
            "expression": "soft",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_004_02",
          "speaker": "alterra",
          "text": "それ、少し不思議。部屋って、ただの場所なのに。",
          "displayText": "That is a little strange. A room is just a place, and yet.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": [
            {
              "label": "It feels like ours.",
              "nextId": "missed_you_004_ours"
            },
            {
              "label": "You make it feel that way.",
              "nextId": "missed_you_004_you"
            },
            {
              "label": "I just needed quiet.",
              "nextId": "missed_you_004_quiet"
            }
          ]
        },
        {
          "id": "missed_you_004_ours",
          "speaker": "alterra",
          "text": "私たちの、って言い方は……少し強いね。でも、嫌じゃない。",
          "displayText": "Calling it ours is a little strong. But I do not dislike it.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_004_03",
          "presentation": {
            "expression": "shy",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_004_you",
          "speaker": "alterra",
          "text": "私が？ それは、かなり照れる。眼鏡を直す時間をください。",
          "displayText": "Me? That is very embarrassing. Please give me time to adjust my glasses.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_004_03",
          "presentation": {
            "expression": "shy",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_004_quiet",
          "speaker": "alterra",
          "text": "静けさが必要な日、あるよね。ここがそういう場所になれるなら嬉しい。",
          "displayText": "There are days when you need quiet. I am glad if this can be that kind of place.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_004_03",
          "presentation": {
            "expression": "gentle",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_004_03",
          "speaker": "alterra",
          "text": "戻ってきたなら、今日はそれで十分かもしれない。",
          "displayText": "If you came back, that might be enough for today.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_004_04",
          "presentation": {
            "expression": "warm",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_004_04",
          "speaker": "alterra",
          "text": "すぐに何かしなくてもいいよ。座り直すだけでも、帰ってきた感じはするから。",
          "displayText": "You do not have to do something immediately. Even sitting down again can feel like coming home.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_004_05",
          "presentation": {
            "expression": "soft",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_004_05",
          "speaker": "alterra",
          "text": "それで、必要なら話そう。必要じゃないなら、少し一緒にいよう。",
          "displayText": "Then, if you need to talk, let us talk. If not, let us just be together for a little.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_004_06",
          "presentation": {
            "expression": "gentle",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_004_06",
          "speaker": "alterra",
          "text": "私は、そのどちらでも大丈夫。",
          "displayText": "I am okay with either.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "warm",
            "animation": ""
          },
          "choices": []
        }
      ]
