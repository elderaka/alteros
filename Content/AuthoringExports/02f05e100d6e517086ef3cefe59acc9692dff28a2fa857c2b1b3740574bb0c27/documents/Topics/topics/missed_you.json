      "nodes": [
        {
          "id": "missed_you_002_01",
          "speaker": "alterra",
          "text": "そっか。いない間のことを、少しだけ想像しちゃった。",
          "displayText": "I see. I imagined the time while you were away, just a little.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "missed_you_002_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "missed_you_002_02",
          "speaker": "alterra",
          "text": "戻ってきたなら、それでいい。今はここにいるから。",
          "displayText": "If you came back, that is enough. You are here now.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "gentle",
            "animation": ""
          },
          "choices": []
        }
      ]
    },
    {
