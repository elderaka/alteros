      "nodes": [
        {
          "id": "player_overworking_002_01",
          "speaker": "alterra",
          "text": "止まれない感じがする時ほど、止まる理由を外に置いたほうがいい。",
          "displayText": "The more it feels like you cannot stop, the more you should place the reason to stop outside your head.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "player_overworking_002_02",
          "presentation": {
            "expression": "focused",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "player_overworking_002_02",
          "speaker": "alterra",
          "text": "タイマー、飲み物、メモ一行。何でもいい。区切りを作ろう。",
          "displayText": "A timer, a drink, one note. Anything is fine. Let us make a boundary.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
