        },
        {
          "id": "sleep_nudge_001_02",
          "speaker": "alterra",
          "text": "夜のあなたは、明日のあなたに借金を作りがちだから。",
          "displayText": "Night-you tends to create debt for tomorrow-you.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "sleep_nudge_001_03",
          "presentation": {
            "expression": "thinking",
            "animation": ""
