      "modifiers": [],
      "consumptionNodeId": "",
      "nodes": [
        {
          "id": "player_bored_002_01",
          "speaker": "alterra",
          "text": "何もないって顔してる。そういう時、私は一覧を作りたくなる。",
          "displayText": "You sound like there is nothing there. At times like that, I want to make a list.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "player_bored_002_02",
          "presentation": {
            "expression": "thinking",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "player_bored_002_02",
          "speaker": "alterra",
          "text": "でも今日は、一覧より先に一つだけ。今の気分に合う小さいことを探そう。",
          "displayText": "But today, before a list, just one thing. Let us find something small that fits your mood.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "warm",
            "animation": ""
          },
