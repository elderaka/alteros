      "modifiers": [],
      "consumptionNodeId": "",
      "nodes": [
        {
          "id": "player_bored_003_01",
          "speaker": "alterra",
          "text": "娯楽係に任命された気配がする。えっと、急に責任が重い。",
          "displayText": "I sense that I have been appointed entertainment officer. Um, that is suddenly a heavy responsibility.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "player_bored_003_02",
          "presentation": {
            "expression": "playful",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "player_bored_003_02",
          "speaker": "alterra",
          "text": "でもいいよ。まず、退屈が眠い退屈なのか、何かしたい退屈なのか見分けよう。",
          "displayText": "But okay. First, let us tell whether this is sleepy boredom or wants-to-do-something boredom.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "warm",
            "animation": ""
          },
          "choices": []
