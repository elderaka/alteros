      "nodes": [
        {
          "id": "player_happy_short_002_01",
          "speaker": "alterra",
          "text": "いい知らせ？ 待って、姿勢を正す。こういうのはちゃんと聞きたい。",
          "displayText": "Good news? Wait, I am sitting up. I want to hear this properly.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "player_happy_short_002_02",
          "presentation": {
            "expression": "happy",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "player_happy_short_002_02",
          "speaker": "alterra",
          "text": "短くてもいいから教えて。あなたの嬉しいこと、私も少し分けてほしい。",
          "displayText": "Tell me, even briefly. I want to share a little of what made you happy.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
            "expression": "happy",
            "animation": ""
