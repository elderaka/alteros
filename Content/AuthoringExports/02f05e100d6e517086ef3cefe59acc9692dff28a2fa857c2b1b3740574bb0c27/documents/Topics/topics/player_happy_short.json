          "choices": []
        },
        {
          "id": "player_happy_short_003_02",
          "speaker": "alterra",
          "text": "その調子、少しだけ保存しておこう。あとで疲れた時の証拠になるから。",
          "displayText": "Let us save a little of that mood. It can be evidence later when you get tired.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "",
          "presentation": {
