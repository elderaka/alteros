        {
          "id": "player_happy_short_003_01",
          "speaker": "alterra",
          "text": "いい顔してる。……たぶん。声だけでも分かる気がする。",
          "displayText": "You sound like you have a good expression. Probably. I feel like I can tell even from your voice.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "player_happy_short_003_02",
          "presentation": {
            "expression": "playful",
            "animation": ""
