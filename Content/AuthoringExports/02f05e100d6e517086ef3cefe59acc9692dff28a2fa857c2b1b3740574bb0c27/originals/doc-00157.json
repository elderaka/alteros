      "id": "sleep_nudge_001_01",
      "speaker": "alterra",
      "text": "うん。寝よう。これはかなり賛成。",
      "displayText": "Mm. Sleep. I am very much in favor of this.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "sleep_nudge_001_02",
      "presentation": {
        "expression": "gentle",
        "animation": ""
