      "presentation": { "expression": "focused", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
      "choices": [],
      "nextId": "inappropriate_boundary_002_03"
    },
    {
      "id": "inappropriate_boundary_002_03",
      "speaker": "altera",
      "text": "それでも一緒にいたいなら、もう少し丁寧に来て。",
      "translatedText": "If you still want to be with me, come a little more gently.",
      "emotion": "firm_gentle",
      "presentation": { "expression": "gentle", "gazeTarget": "player" },
      "language": "japanese",
      "audioPath": "",
