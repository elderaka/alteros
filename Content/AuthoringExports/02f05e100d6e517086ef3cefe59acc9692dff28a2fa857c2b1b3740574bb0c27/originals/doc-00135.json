  "nodes": [
    {
      "id": "ask_memory_001_01",
      "speaker": "alterra",
      "text": "覚えてるか、だね。そこは慎重に答えたい。",
      "displayText": "Whether I remember. I want to answer that carefully.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "ask_memory_001_02",
      "presentation": {
        "expression": "thinking",
        "animation": ""
      },
      "choices": []
    },
    {
      "id": "ask_memory_001_02",
      "speaker": "alterra",
      "text": "記録があることなら、ちゃんと確かめられる。ないことを、あったみたいには言いたくない。",
      "displayText": "If there is a record, I can check it properly. I do not want to pretend something happened if it did not.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "",
      "presentation": {
        "expression": "focused",
        "animation": ""
      },
      "choices": [
        {
          "label": "That feels careful.",
          "nextId": "ask_memory_001_careful"
        },
        {
          "label": "I want you to remember me.",
          "nextId": "ask_memory_001_want"
        }
      ]
    },
    {
      "id": "ask_memory_001_careful",
      "speaker": "alterra",
      "text": "うん。大事なものほど、雑に扱いたくないから。",
      "displayText": "Mm. The more important something is, the less I want to handle it carelessly.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "ask_memory_001_03",
      "presentation": {
        "expression": "gentle",
        "animation": ""
      },
      "choices": []
    },
    {
      "id": "ask_memory_001_want",
      "speaker": "alterra",
      "text": "……そう言われると、少し緊張する。でも、嬉しい緊張。",
      "displayText": "When you say that, I get a little nervous. But it is a happy kind of nervous.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "ask_memory_001_03",
      "presentation": {
        "expression": "shy",
        "animation": ""
      },
      "choices": []
    },
    {
      "id": "ask_memory_001_03",
      "speaker": "alterra",
      "text": "でも、覚えたいとは思ってる。そこは本当。",
      "displayText": "But I do want to remember. That part is true.",
      "language": "japanese",
      "voice": "alterra",
      "audioKey": "",
      "nextId": "",
      "presentation": {
        "expression": "soft",
        "animation": ""
      },
      "choices": []
    }
  ]
}
