          },
          "choices": []
        },
        {
          "id": "room_or_desk_comment_002_02",
          "speaker": "alterra",
          "text": "机の上が整うと、考えごとも少し座る場所を見つける気がする。",
          "displayText": "When the desk is orderly, I feel like thoughts find somewhere to sit.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "room_or_desk_comment_002_03",
          "presentation": {
            "expression": "warm",
            "animation": ""
          },
          "choices": []
        },
        {
          "id": "room_or_desk_comment_002_03",
          "speaker": "alterra",
          "text": "ちょっと羨ましい。私もノートの端をそろえたくなってきた。",
          "displayText": "I am a little jealous. Now I want to line up the edges of a notebook.",
          "language": "japanese",
          "voice": "alterra",
          "audioKey": "",
          "nextId": "room_or_desk_comment_002_04",
          "presentation": {
