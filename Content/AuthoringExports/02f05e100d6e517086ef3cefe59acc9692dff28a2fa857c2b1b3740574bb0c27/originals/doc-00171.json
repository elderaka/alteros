          "choices": []
        },
        {
          "id": "room_or_desk_comment_001_02",
          "speaker": "alterra",
          "text": "だから、作業する場所だけ救出しよう。小さい島を作る感じ。",
          "displayText": "So rescue only the place where you work. Like making a small island.",
          "language": "japanese",
